# Theme: 1ST_GEN_REMIX
# Version 1.0 (1024x768 HiDPI)
# Last Update: 01/26/2026
# License: CC-BY-SA 3.0
# By: Monica G.
# Description: Theme based on the iPod classic 1st generation's UI with some added features.
# Icons & viewers based on Susan Kare's classic Macintosh icons.
# Code based on: BACKBONE and Pixel Computer by me! which are based on SNARTY by Simon Anden and BONES by Chuck Largo!
# Hold screen is stripped back from the WPS to make room for album art.

# SBS File

# Disable Status Bar
%wd

# Disable Title
%?Lt<|>

# Preload Images (only USB screen bitmaps are needed)
%xl(sad_mac,sad_mac.bmp,0,0)
%xl(battery,battery.bmp,0,0,5)

# Display Viewports (Header is rendered by the Rust GPU UI engine; only USB screen uses skin viewports)
%?if(%cs, =, 21)<%VI(clearScreen)%Vd(usbScreen)|%VI(mainMenu)>

# Clear Screen
%Vi(clearScreen,0,0,1,1,-)

## Main Menu ##

# Main Menu UI Viewport (y=144..736 matches Rust GPU Header + 8-row content band)
%Vi(mainMenu,32,144,960,592,1)

## USB Screen ##

# USB Screen Viewport
%Vl(usbScreen,0,0,1024,768,-)

# Time / Battery (numerical)
%Vl(usbScreen,128,30,740,76,1)
%t(10)%ac%?cf<%ac%cH|%cl>:%cM%?cf<| %cP>;%t(10)%acBattery: %bl%%

# Battery
%Vl(usbScreen,885,30,120,54,1)
%?if(%bl, >, 75)<%xd(battery,5)|%?if(%bl, >, 50)<%xd(battery,4)|%?if(%bl, >, 25)<%xd(battery,3)|%?if(%bl, >, 10)<%xd(battery,2)|%xd(battery,1)>>>>

# Line
%Vl(usbScreen,16,115,992,6,-)
%dr(0,0,992,6)

# USB Mac Icon (285x360)
%Vl(usbScreen,714,248,285,360,-)
%xd(sad_mac)

# USB Text
%Vl(usbScreen,16,304,672,86,1)
%acUSB CONNECTED%Vs(invert)

# USB Eject Box
%Vl(usbScreen,16,416,672,86,-)
%dr(0,0,672,3)%dr(0,0,3,86)%dr(669,0,3,86)%dr(0,83,672,3)

# Eject Warning
%Vl(usbScreen,19,430,666,58,1)
%ac%t(1)! EJECT BEFORE DISCONNECTING !;%t(.1)%ac
